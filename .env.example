APP_ENV=development
APP_NAME=IndaVerse
INDAVERSE_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql+psycopg://indaverse:REPLACE_WITH_RANDOM_HEX@127.0.0.1:5432/indaverse
REDIS_URL=redis://127.0.0.1:6379/0
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
API_URL=http://localhost:8002
APP_URL=http://localhost:3000

# Production requires HTTPS origins, a strong secret and secure cookies.
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
# JSON arrays; replace these for your deployed hostnames.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Local development only: requires ffmpeg and ffprobe on the API process PATH.
VIDEO_CLIP_EXPORT_ENABLED=false

# Enable only after migrating and granting access to intended existing accounts.
PRIVATE_BETA=false

# Credits are visible in the wallet. Keep quota enforcement off during migration/rehearsal.
CREDIT_ENFORCEMENT=false
# Optional: CREDIT_POLICY as JSON. See docs/CREDITS-AND-ENTITLEMENTS.md.

# Opt-in Paystack test checkout; never enter live keys. See docs/PAYSTACK-SANDBOX.md.
PAYSTACK_SANDBOX_ENABLED=false
PAYSTACK_ALLOW_LEGACY_SIGNATURE=false
# Set PAYSTACK_TEST_SECRET and PAYSTACK_WEBHOOK_SECRET in the server environment.
# Optional CREDIT_BUNDLES JSON defines test bundle quantities and prices.
